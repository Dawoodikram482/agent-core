# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every service built on agent-core reads these.

SERVICE_NAME=agent
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# auto (console in development, JSON elsewhere) | json | console
LOG_FORMAT=auto

# Langfuse tracing: on only when both keys are set (needs agent-core[langfuse])
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
