# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Every service built on agent-core reads these.

SERVICE_NAME=agent
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# auto (console in development, JSON elsewhere) | json | console
LOG_FORMAT=auto

# Langfuse tracing: on only when both keys are set (needs agent-core[langfuse])
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM gateway (LLMSettings). Providers are tried in this order; any without a key are skipped.
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Optional third provider:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Retry policy (per provider, before falling back)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8
